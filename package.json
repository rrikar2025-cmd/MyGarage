{
  "name": "my-garage",
  "version": "0.6.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run typecheck && npm test && npm run check:architecture",
    "export:web": "expo export --platform web",
    "android:release": "node scripts/build-android-release.mjs",
    "preview": "node scripts/preview.mjs",
    "format": "prettier --write app src tests scripts app.config.ts *.json *.md locales plugins modules/obd/src supabase/functions supabase/*.md",
    "format:check": "prettier --check app src tests scripts app.config.ts *.json *.md locales plugins modules/obd/src supabase/functions supabase/*.md",
    "postexport:web": "node scripts/verify-export-config.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.0.14",
    "@supabase/supabase-js": "^2.0.0",
    "expo": "~54.0.37",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "obd": "file:./modules/obd",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
